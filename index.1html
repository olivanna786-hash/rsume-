<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Made by Freya – full site preview</title>
<style>:root{--bg:#121212;--panel:#1b1b1b;--line:#2c2c2c;--ink:#ece8df;--mute:#a8a29a;--gold:#c9a24a;--serif:ui-serif,Georgia,"Times New Roman",serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--serif);line-height:1.65;overflow-x:hidden}
a{color:var(--gold)}img{max-width:100%;height:auto;display:block}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.skip{position:absolute;left:-999px;top:8px;background:var(--gold);color:#000;padding:8px 12px;z-index:100}.skip:focus{left:8px}
.header{position:sticky;top:0;z-index:10;display:flex;flex-wrap:wrap;gap:8px 24px;align-items:center;justify-content:space-between;padding:12px 20px;background:rgba(18,18,18,.95);border-bottom:1px solid var(--line)}
.brand{color:var(--ink);text-decoration:none;font-size:20px;letter-spacing:.04em}
.header ul{display:flex;flex-wrap:wrap;gap:4px 18px;list-style:none;margin:0;padding:0}.header nav a{color:var(--mute);text-decoration:none;font-size:14px}.header nav a:hover{color:var(--gold)}
.hero{text-align:center;padding:84px 20px 56px;animation:fade .6s ease both}
.eyebrow{color:var(--gold);letter-spacing:.25em;text-transform:uppercase;font-size:12px;margin:0}
h1,h2,h3{font-weight:400;line-height:1.2}h1{font-size:clamp(36px,8vw,64px);margin:12px 0}h2{font-size:clamp(26px,5vw,36px);margin:0 0 24px;text-align:center}
.lead{color:var(--mute);max-width:36ch;margin:0 auto 28px}
.btn{display:inline-block;background:var(--gold);color:#111;border:0;border-radius:4px;padding:12px 24px;font:inherit;text-decoration:none;cursor:pointer;margin-top:12px;transition:filter .2s}
.btn:hover{filter:brightness(1.1)}.btn:disabled{opacity:.6;cursor:wait}
.section{max-width:1100px;margin:0 auto;padding:56px 20px;border-top:1px solid var(--line)}.narrow{max-width:640px}.center{text-align:center}
.filters{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:28px}
.chip{background:none;border:1px solid var(--line);color:var(--mute);border-radius:20px;padding:6px 14px;font:inherit;font-size:14px;cursor:pointer}
.chip[aria-pressed=true]{border-color:var(--gold);color:var(--gold)}
.grid{list-style:none;margin:0;padding:0;display:grid;gap:28px;grid-template-columns:1fr}
@media(min-width:560px){.grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}
figure{margin:0}figcaption{display:flex;flex-direction:column;margin-top:8px;font-size:14px}figcaption span{color:var(--mute)}
.img-fallback{aspect-ratio:4/5;display:grid;place-items:center;background:var(--panel);color:var(--mute);border:1px dashed var(--line)}
.cards{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.cards li{background:var(--panel);border:1px solid var(--line);padding:20px}.cards h3{margin:0 0 6px;color:var(--gold);font-size:19px}.cards p{margin:0;color:var(--mute);font-size:15px}
.empty{text-align:center;color:var(--mute)}
form label{display:block;margin:16px 0 4px;font-size:14px}
input,select,textarea{width:100%;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:11px;font:inherit;font-size:16px}
input[aria-invalid],select[aria-invalid],textarea[aria-invalid]{border-color:#d9776b}
.hp{position:absolute;left:-9999px;height:0;overflow:hidden}
.err{color:#e59b90;font-size:14px;margin:4px 0 0}.ok{color:#9fd3a0;margin-top:14px}
.plain{list-style:none;padding:0}.plain li{margin:16px 0}.k{display:block;color:var(--mute);font-size:13px;letter-spacing:.1em;text-transform:uppercase}.wrap{overflow-wrap:anywhere}
.footer{text-align:center;padding:32px 20px;color:var(--mute);border-top:1px solid var(--line);font-size:14px}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
.sec-h{font-size:clamp(26px,5vw,36px);margin:0 0 24px;text-align:center}
.menu{position:relative}
.menu-btn{background:none;border:1px solid var(--line);color:var(--ink);width:42px;height:42px;border-radius:50%;font-size:26px;line-height:1;cursor:pointer}
.menu-btn:hover{border-color:var(--gold);color:var(--gold)}
.menu-panel{position:absolute;right:0;top:50px;min-width:200px;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 0;z-index:20}
.header .menu-panel ul{display:block}
.header .menu-panel a{display:block;padding:10px 18px;color:var(--ink);font-size:16px}
.header .menu-panel a:hover{color:var(--gold)}
 html{background:#121212}.pv-note{background:#2a2412;color:#e8d9a8;font-size:13px;padding:8px 14px;text-align:center}.typed{min-height:1.25em}
.caret{display:inline-block;width:2px;height:.85em;background:var(--gold);margin-left:4px;vertical-align:-.05em;opacity:0}
.caret.on{opacity:1;animation:blink .9s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.pillars{color:var(--gold);font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin:0}
</style></head><body>
<div class="pv-note">PREVIEW (not the deployed build)</div>
<header class="header"><a class="brand" href="#top">Made by Freya</a><div class="menu" id="menu"><button type="button" class="menu-btn" id="mb" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu"><span aria-hidden="true">⋮</span></button><nav id="site-menu" class="menu-panel" aria-label="Main" hidden><ul><li><a href="#top">Home</a></li><li><a href="#portfolio">Portfolio</a></li><li><a href="#commission-art">Commission Art</a></li><li><a href="#about">About</a></li><li><a href="#request">Request</a></li><li><a href="#contact">Contact</a></li></ul></nav></div></header>
<main id="main"><div id="v"></div></main><footer class="footer"><p>© 2026 Made by Freya</p></footer>
<template id="home"><section class="hero" id="top"><p class="eyebrow">Illustrator · Character Artist</p><h1 id="tt" class="typed" aria-label="Made by Freya"><span aria-hidden="true"></span><span class="caret" aria-hidden="true"></span></h1><p class="lead">Professional fantasy, D&amp;D and character illustration for tabletop players, authors and creators.</p><p class="pillars">D&amp;D Art · Fantasy Art · Book Covers · VTuber Art · Creator Art</p></section>
<section id="featured" class="section"><h2 class="sec-h">Featured Work</h2><ul class="grid" data-g="f"></ul></section><p class="center"><a class="btn" href="#portfolio">View full portfolio</a></p>
<section id="commission-art" class="section"><h2>Commission Art</h2><ul class="cards"><li><h3>D&amp;D Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>Fantasy Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>Character Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>Book Cover Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>VTuber Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>YouTube Creator Art</h3><p>Add a one-line description of this commission type.</p></li><li><h3>Digital Illustrations</h3><p>Add a one-line description of this commission type.</p></li><li><h3>Other Art</h3><p>Add a one-line description of this commission type.</p></li></ul><p class="center"><a class="btn" href="#request">Start a request</a></p></section>
<section id="about" class="section narrow"><h2>About the Artist</h2><p>I’m a digital artist passionate about bringing creative ideas to life through detailed fantasy art, character illustrations and custom commissions. Every piece is crafted with care, creativity and attention to detail to bring your vision to life.</p></section>
<section id="request" class="section narrow"><h2>Commission Request</h2><form id="form" novalidate><label for="n">Name</label><input id="n"><label for="em">Contact email</label><input id="em" type="email"><label for="ct">Art category</label><select id="ct"><option value="">Select…</option><option>D&amp;D Art</option><option>Fantasy Art</option><option>Character Art</option><option>Book Cover Art</option><option>VTuber Art</option><option>YouTube Creator Art</option><option>Digital Illustrations</option><option>Other Art</option></select><label for="ds">Project description</label><textarea id="ds" rows="6"></textarea><label for="bd">Budget</label><input id="bd" placeholder="A rough range is fine"><label for="dl">Deadline (optional)</label><input id="dl" type="date"><button class="btn" type="submit">Send request</button><p class="err" id="fm"></p></form></section>
<section id="contact" class="section narrow center"><h2>Contact</h2><ul class="plain"><li><span class="k">Email</span> <a class="wrap" href="mailto:freyaaly786@gmail.com">freyaaly786@gmail.com</a></li><li><span class="k">Instagram</span> <a href="https://www.instagram.com/madebyfreya2" target="_blank" rel="noopener">@madebyfreya2</a></li><li><span class="k">TikTok</span> <a href="https://www.tiktok.com/@madebylexi2" target="_blank" rel="noopener">@madebylexi2</a></li></ul></section></template>
<template id="port"><section class="section"><h1 class="sec-h">Portfolio</h1><ul class="grid" data-g="a"></ul></section></template>
<script>var P=[{"t": "Riders at Sunset", "d": "A knight in polished armor and a red-haired companion ride beneath a pastel sky, with petals and hearts drifting past.", "w": 1280, "h": 1600, "f": true, "u": "data:image/webp;base64,"}, {"t": "Midnight Throne", "d": "A horned, pointed-eared figure lounges on a gilded throne with glowing blue wings against a starry night.", "w": 1280, "h": 1600, "f": true, "u": "data:image/webp;base64,"}, {"t": "Crossed Arms", "d": "Clean flat-color character portrait of a long-haired woman in a cropped red hoodie and black choker.", "w": 711, "h": 889, "f": false, "u": "data:image/webp;base64,"}, {"t": "Braids and Two-Tone Eyes", "d": "Character portrait with long braids, white streaks in dark hair and mismatched blue and brown eyes.", "w": 679, "h": 849, "f": false, "u": "data:image/webp;base64,"}, {"t": "The Tattooed Trio", "d": "A three-character lineup with intricate full-body tattoo designs, flowing robes and bold red accents.", "w": 1280, "h": 1152, "f": false, "u": "data:image/webp;base64,"}, {"t": "Scholar in the Grove", "d": "A golden-haired mage meditates in a sunlit grove, reading a spellbook as a warm aura glows around him.", "w": 1280, "h": 1516, "f": true, "u": "data:image/webp;base64,"}, {"t": "Commander in the Fire", "d": "Digital fan illustration of an armored blue-and-gold space marine commander standing in smoke and flame.", "w": 1280, "h": 720, "f": true, "u": "data:image/webp;base64,"}, {"t": "Moon Over the Peaks", "d": "A blue-haired girl looks back over her shoulder before a giant moon, painted mountains and a windswept tree.", "w": 1280, "h": 911, "f": false, "u": "data:image/webp;base64,"}, {"t": "Chibi Warrior", "d": "Chibi-style fan illustration of a spiky-haired fighter with red fur and a tail on a crimson gradient.", "w": 1280, "h": 1280, "f": false, "u": "data:image/webp;base64,"}, {"t": "Druid of the Ancient Grove", "d": "A horned druid with a spiked staff stands on a forest path beneath a huge moon, framed by ancient ruins.", "w": 1280, "h": 1280, "f": false, "u": "data:image/webp;base64,"}, {"t": "Starlit Mage Design", "d": "Full-length design of a lavender-haired elf with round glasses, a star hair clip and a layered violet gown.", "w": 519, "h": 1019, "f": false, "u": "data:image/webp;base64,"}, {"t": "Azure Warrior Character Sheet", "d": "A blue-skinned warrior with glowing glyph tattoos, shown in two outfit variants beside a runed greatsword.", "w": 1170, "h": 824, "f": false, "u": "data:image/webp;base64,"}, {"t": "The Buccaneer", "d": "Full-body illustration of a blonde swashbuckler in a blue bandana, corset vest and billowing trousers.", "w": 1170, "h": 1560, "f": false, "u": "data:image/webp;base64,"}, {"t": "Dragon in the Glade", "d": "A traveler with a pack pauses in a glowing mushroom glade while a teal dragon watches from the trees.", "w": 1170, "h": 907, "f": false, "u": "data:image/webp;base64,"}];
function e(s){return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;")}
function cards(l){return l.map(function(p){return '<li><figure><img src="'+p.u+'" width="'+p.w+'" height="'+p.h+'" alt="'+e(p.t)+'" loading="lazy"><figcaption><strong>'+e(p.t)+'</strong><span>'+e(p.d)+'</span></figcaption></figure></li>'}).join("")}
function menu(o){var m=document.getElementById("site-menu");m.hidden=!o;document.getElementById("mb").setAttribute("aria-expanded",String(o))}
var TT=0;function typeTitle(){var el=document.getElementById("tt");if(!el)return;var t="Made by Freya",s=el.querySelector("span"),c=el.querySelector(".caret"),id=++TT;if(window.matchMedia("(prefers-reduced-motion: reduce)").matches){s.textContent=t;return}c.className="caret on";var n=0;(function k(){if(id!==TT)return;if(n<t.length){n++;s.textContent=t.slice(0,n);setTimeout(k,110)}else c.className="caret"})();setTimeout(function(){},0)}
function route(){var h=location.hash,pt=h==="#portfolio",v=document.getElementById("v");v.innerHTML="";v.appendChild(document.getElementById(pt?"port":"home").content.cloneNode(true));
var g=v.querySelector("[data-g]");g.innerHTML=cards(pt?P:P.filter(function(p){return p.f}));
var f=document.getElementById("form");if(f)f.addEventListener("submit",function(ev){ev.preventDefault();document.getElementById("fm").textContent="Preview only: the form works on the deployed site once the form service is set up."});
var el=!pt&&h.length>1?document.getElementById(h.slice(1)):null;if(el)el.scrollIntoView();else window.scrollTo(0,0);setTimeout(typeTitle,350)}
document.getElementById("mb").onclick=function(){menu(document.getElementById("site-menu").hidden)};
document.getElementById("site-menu").onclick=function(ev){if(ev.target.tagName==="A")menu(false)};
document.addEventListener("keydown",function(ev){if(ev.key==="Escape")menu(false)});
document.addEventListener("mousedown",function(ev){if(!document.getElementById("menu").contains(ev.target))menu(false)});
window.addEventListener("hashchange",route);route();</script></body></html>